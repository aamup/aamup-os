#!/usr/bin/env bash
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/aamup-os"
ENV_FILE="${AAMUP_ENV_FILE:-$CONFIG_DIR/dev.env}"

cd "$ROOT"

bold() { printf '\033[1m%s\033[0m\n' "$*"; }
ok()   { printf '✓ %s\n' "$*"; }
warn() { printf '! %s\n' "$*"; }
fail() { printf '✗ %s\n' "$*"; }

load_env() {
  if [[ -f "$ENV_FILE" ]]; then
    # shellcheck disable=SC1090
    set -a
    source "$ENV_FILE"
    set +a
  fi
}

ollama_root() {
  local base="${AAMUP_EMBED_BASE_URL:-${AAMUP_LLM_BASE_URL:-http://127.0.0.1:11434/v1}}"
  base="${base%/}"
  base="${base%/v1}"
  printf '%s' "$base"
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1
}

doctor() {
  load_env
  local failures=0
  local root
  root="$(ollama_root)"

  echo
  bold "AAMUP // DOCTOR"
  echo

  bold "PROJECT"
  if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    ok "Git repository detected"
  else
    fail "Not inside a Git repository"
    failures=$((failures + 1))
  fi

  local branch
  branch="$(git branch --show-current 2>/dev/null || true)"
  [[ -n "$branch" ]] && ok "Branch: $branch" || {
    fail "Could not determine branch"
    failures=$((failures + 1))
  }

  if [[ -z "$(git status --porcelain 2>/dev/null)" ]]; then
    ok "Working tree clean"
  else
    warn "Working tree has local changes"
    git status --short
  fi

  if git remote get-url origin >/dev/null 2>&1; then
    ok "Origin: $(git remote get-url origin)"
  else
    fail "Git origin is not configured"
    failures=$((failures + 1))
  fi

  echo
  bold "TOOLCHAIN"
  for cmd in node npm cargo rustc python3 curl ollama; do
    if require_cmd "$cmd"; then
      case "$cmd" in
        node) ok "node $(node --version)" ;;
        npm) ok "npm $(npm --version)" ;;
        cargo) ok "cargo $(cargo --version | awk '{print $2}')" ;;
        rustc) ok "rustc $(rustc --version | awk '{print $2}')" ;;
        ollama) ok "ollama installed" ;;
        *) ok "$cmd installed" ;;
      esac
    else
      fail "$cmd missing"
      failures=$((failures + 1))
    fi
  done

  echo
  bold "CONFIG"
  if [[ -f "$ENV_FILE" ]]; then
    ok "$ENV_FILE"
    local perms
    perms="$(stat -c '%a' "$ENV_FILE" 2>/dev/null || true)"
    if [[ "$perms" == "600" ]]; then
      ok "Config permissions: 600"
    else
      warn "Config permissions are ${perms:-unknown}; recommended 600"
    fi
  else
    fail "Missing $ENV_FILE"
    failures=$((failures + 1))
  fi

  for var in \
    AAMUP_LLM_BASE_URL \
    AAMUP_LLM_MODEL \
    AAMUP_EMBED_BASE_URL \
    AAMUP_EMBED_MODEL
  do
    if [[ -n "${!var:-}" && "${!var}" != "..." ]]; then
      ok "$var=${!var}"
    else
      fail "$var is missing or still a placeholder"
      failures=$((failures + 1))
    fi
  done

  echo
  bold "OLLAMA"
  if curl -fsS --max-time 3 "$root/api/tags" >/dev/null 2>&1; then
    ok "Server: $root"
  else
    fail "Ollama server unreachable at $root"
    failures=$((failures + 1))
  fi

  if [[ -n "${AAMUP_LLM_MODEL:-}" ]]; then
    if ollama show "$AAMUP_LLM_MODEL" >/dev/null 2>&1; then
      ok "Chat model installed: $AAMUP_LLM_MODEL"
    else
      fail "Chat model not installed: $AAMUP_LLM_MODEL"
      failures=$((failures + 1))
    fi
  fi

  if [[ -n "${AAMUP_EMBED_MODEL:-}" ]]; then
    if ollama show "$AAMUP_EMBED_MODEL" >/dev/null 2>&1; then
      ok "Embedding model installed: $AAMUP_EMBED_MODEL"
    else
      fail "Embedding model not installed: $AAMUP_EMBED_MODEL"
      failures=$((failures + 1))
    fi
  fi

  echo
  bold "MODEL API"

  if [[ -n "${AAMUP_LLM_BASE_URL:-}" && -n "${AAMUP_LLM_MODEL:-}" ]]; then
    if python3 - "$AAMUP_LLM_BASE_URL" "$AAMUP_LLM_MODEL" <<'PY'
import json
import sys
import urllib.request

base = sys.argv[1].rstrip("/")
model = sys.argv[2]
payload = json.dumps({
    "model": model,
    "messages": [{"role": "user", "content": "Reply only with OK."}],
    "temperature": 0,
}).encode()

req = urllib.request.Request(
    base + "/chat/completions",
    data=payload,
    headers={"Content-Type": "application/json"},
)
try:
    with urllib.request.urlopen(req, timeout=10) as response:
        data = json.load(response)
    content = (
        data.get("choices", [{}])[0]
        .get("message", {})
        .get("content", "")
    )
    if not content.strip():
        raise RuntimeError("empty chat response")
except Exception as exc:
    print(exc, file=sys.stderr)
    raise SystemExit(1)
PY
    then
      ok "Chat completion probe passed"
    else
      fail "Chat completion probe failed"
      failures=$((failures + 1))
    fi
  fi

  if [[ -n "${AAMUP_EMBED_MODEL:-}" ]]; then
    if python3 - "$root" "$AAMUP_EMBED_MODEL" <<'PY'
import json
import sys
import urllib.request

root = sys.argv[1].rstrip("/")
model = sys.argv[2]
payload = json.dumps({
    "model": model,
    "input": ["AAMUP semantic memory health check"],
}).encode()

req = urllib.request.Request(
    root + "/api/embed",
    data=payload,
    headers={"Content-Type": "application/json"},
)
try:
    with urllib.request.urlopen(req, timeout=15) as response:
        data = json.load(response)
    vectors = data.get("embeddings", [])
    if not vectors or not vectors[0]:
        raise RuntimeError("empty embedding response")
    print(len(vectors[0]))
except Exception as exc:
    print(exc, file=sys.stderr)
    raise SystemExit(1)
PY
    then
      ok "Embedding probe passed"
    else
      fail "Embedding probe failed"
      failures=$((failures + 1))
    fi
  fi

  echo
  if [[ "$failures" -eq 0 ]]; then
    bold "DOCTOR RESULT // HEALTHY"
    return 0
  fi

  bold "DOCTOR RESULT // $failures ISSUE(S)"
  return 1
}

check() {
  load_env
  echo
  bold "AAMUP // FAST CHECK"
  npm run typecheck || return 1
  (
    cd src-tauri
    cargo check
  ) || return 1
  echo
  ok "Fast check passed"
}

test_suite() {
  load_env
  echo
  bold "AAMUP // TEST"
  npm run typecheck || return 1
  (
    cd src-tauri
    cargo test --lib
  ) || return 1
  echo
  ok "Automated tests passed"
}

verify() {
  load_env
  echo
  bold "AAMUP // FULL VERIFY"

  npm run typecheck || return 1
  npm run build || return 1

  (
    cd src-tauri
    cargo fmt -- --check
    cargo check
    cargo test --lib
    cargo clippy --all-targets --all-features -- -D warnings
  ) || return 1

  echo
  ok "Full verification passed"
}

package_app() {
  load_env
  echo
  bold "AAMUP // PACKAGE"
  npm run tauri build -- --bundles appimage,deb || return 1
  echo
  ok "Linux bundles created"
  find src-tauri/target/release/bundle -maxdepth 3 -type f \
    \( -name '*.AppImage' -o -name '*.deb' \) -print 2>/dev/null || true
}

dev() {
  load_env

  if [[ ! -f "$ENV_FILE" ]]; then
    fail "Missing $ENV_FILE"
    echo "Run: ./aamup setup"
    return 1
  fi

  if [[ -z "${AAMUP_LLM_MODEL:-}" || -z "${AAMUP_EMBED_MODEL:-}" ]]; then
    fail "Model configuration is incomplete"
    echo "Run: ./aamup doctor"
    return 1
  fi

  echo
  bold "AAMUP // DEV"
  echo "CHAT  :: ${AAMUP_LLM_MODEL}"
  echo "EMBED :: ${AAMUP_EMBED_MODEL}"
  echo

  npm run tauri dev
}

setup() {
  mkdir -p "$CONFIG_DIR"

  if [[ -f "$ENV_FILE" ]]; then
    warn "$ENV_FILE already exists; leaving it unchanged"
  else
    cat > "$ENV_FILE" <<'ENV'
export AAMUP_LLM_BASE_URL="http://127.0.0.1:11434/v1"
export AAMUP_LLM_MODEL="qwen2.5:3b"
export AAMUP_EMBED_BASE_URL="http://127.0.0.1:11434/v1"
export AAMUP_EMBED_MODEL="nomic-embed-text"
ENV
    chmod 600 "$ENV_FILE"
    ok "Created $ENV_FILE"
  fi

  load_env

  if require_cmd ollama; then
    if [[ -n "${AAMUP_LLM_MODEL:-}" ]] && ! ollama show "$AAMUP_LLM_MODEL" >/dev/null 2>&1; then
      echo "Pulling chat model: $AAMUP_LLM_MODEL"
      ollama pull "$AAMUP_LLM_MODEL" || return 1
    fi

    if [[ -n "${AAMUP_EMBED_MODEL:-}" ]] && ! ollama show "$AAMUP_EMBED_MODEL" >/dev/null 2>&1; then
      echo "Pulling embedding model: $AAMUP_EMBED_MODEL"
      ollama pull "$AAMUP_EMBED_MODEL" || return 1
    fi
  fi

  doctor
}

guard_staged_secrets() {
  local bad
  bad="$(
    git diff --cached --name-only |
      grep -E '(^|/)(\.env($|\.)|.*(secret|credential).*)|(\.pem$|\.key$|\.p12$|\.pfx$)' ||
      true
  )"

  if [[ -n "$bad" ]]; then
    fail "Refusing to commit potentially sensitive files:"
    printf '%s\n' "$bad"
    return 1
  fi
}

ship() {
  local message="${*:-}"

  if [[ -z "$message" ]]; then
    fail 'Usage: ./aamup ship "commit message"'
    return 2
  fi

  load_env

  if [[ -z "$(git status --porcelain)" ]]; then
    warn "Nothing to ship"
    return 0
  fi

  verify || return 1

  echo
  bold "AAMUP // SHIP"
  git diff --stat
  git add -A
  guard_staged_secrets || {
    git reset
    return 1
  }

  if git diff --cached --quiet; then
    warn "Nothing staged"
    return 0
  fi

  git commit -m "$message" || return 1

  local branch
  branch="$(git branch --show-current)"
  git push origin "$branch" || return 1

  echo
  ok "Pushed $branch"
}

sync_repo() {
  local branch
  branch="$(git branch --show-current)"

  if [[ -n "$(git status --porcelain)" ]]; then
    fail "Working tree is dirty; refusing pull"
    git status --short
    return 1
  fi

  git pull --ff-only origin "$branch"
}

status_cmd() {
  load_env
  echo
  bold "AAMUP // STATUS"
  git status -sb
  echo
  echo "CHAT  :: ${AAMUP_LLM_MODEL:-NOT CONFIGURED}"
  echo "EMBED :: ${AAMUP_EMBED_MODEL:-NOT CONFIGURED}"
  echo "ENV   :: $ENV_FILE"
}

help_cmd() {
  cat <<'HELP'
AAMUP OS developer harness

Usage:
  ./aamup setup
  ./aamup doctor
  ./aamup dev
  ./aamup check
  ./aamup test
  ./aamup verify
  ./aamup package
  ./aamup ship "commit message"
  ./aamup sync
  ./aamup status

Commands:
  setup   Create local model config and pull missing Ollama models.
  doctor  Check repo, toolchain, config, Ollama, chat, and embeddings.
  dev     Load persistent config and launch Tauri development mode.
  check   Fast inner-loop validation: TypeScript + cargo check.
  test    Typecheck + Rust automated regression tests.
  verify  Full validation including build, fmt, tests, and clippy.
  package Build Linux AppImage and DEB bundles.
  ship    Verify, secret-guard, commit all project changes, and push.
  sync    Fast-forward the current branch from origin.
  status  Show concise project/model configuration state.
HELP
}

case "${1:-help}" in
  setup)
    shift
    setup "$@"
    ;;
  doctor)
    shift
    doctor "$@"
    ;;
  dev)
    shift
    dev "$@"
    ;;
  check)
    shift
    check "$@"
    ;;
  test)
    shift
    test_suite "$@"
    ;;
  verify)
    shift
    verify "$@"
    ;;
  package)
    shift
    package_app "$@"
    ;;
  ship)
    shift
    ship "$@"
    ;;
  sync)
    shift
    sync_repo "$@"
    ;;
  status)
    shift
    status_cmd "$@"
    ;;
  help|-h|--help)
    help_cmd
    ;;
  *)
    fail "Unknown command: $1"
    echo
    help_cmd
    exit 2
    ;;
esac
